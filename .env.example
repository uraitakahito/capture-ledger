# capture-ledger の環境変数。`cp -n .env.example .env` で写して `.env` を作る。
#
# 空文字は「無い」と同じ意味に揃えてある (POSIX の ${VAR:-word} 側)。そのうえで
# **既定値を持つ変数が空で設定されていたら、起動時に落とす** —— 黙って既定値に
# 戻すと「既定値のままにしたつもりが無かった」誤りが見えなくなるため。
#
# したがってこのファイルの行は 2 種類しかない:
#
#   <NAME>=value    値を渡す
#   #<NAME>=value   既定値を見せるだけ (使うならコメントを外して値を書く)
#
# **生の空行 (NAME=) を書いてよいのは必須の変数だけ。** 必須の空は「不足」として
# 報告されるが、任意の空は既定値を潰すので落とされる。scripts/check-env.mjs が
# この規則を検査している。
#
# **`.env` の出どころはこのファイルだけ。** `.env` はここを cp しただけの写しで、
# 別の一覧はどこにも無い。
#
# **この一覧は scripts/check-env.mjs が見張っている。** src/ と scripts/ が
# 実際に読む変数とここが食い違うと CI が落ちる —— 古い雛形は、雛形が無いより
# 悪い。「これで全部だ」と信じて使うので、足りないときに理由の見当がつかなくなる。

# ── 接続先 ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://capture_ledger:capture_ledger@postgres.capture-ledger:5432/capture_ledger

# ── 成果物ストア (S3) ───────────────────────────────────────────────
# host から叩くので publish されたポート。コンテナの中からなら
# seaweedfs.capture-ledger:8333 になる。
CAPTURE_LEDGER_S3_ENDPOINT=http://127.0.0.1:8333
# capture-ledger は BrowserHive が置いた成果物を読む側なので、名前は向こうに合わせる。
CAPTURE_LEDGER_S3_BUCKET=browserhive
CAPTURE_LEDGER_S3_ACCESS_KEY_ID=browserhive
CAPTURE_LEDGER_S3_SECRET_ACCESS_KEY=browserhive
# 同梱の SeaweedFS は bucket の subdomain 用のワイルドカード DNS を持たないので、
# virtual-hosted 形式の宛先は当たらない。
CAPTURE_LEDGER_S3_FORCE_PATH_STYLE=true
#CAPTURE_LEDGER_S3_REGION=us-east-1

# ── 認可 (OpenFGA) ──────────────────────────────────────────────────
# **この 2 つは `pnpm run fga:deploy` が出力した id を貼る。** 起動前には決まらない
# ので、雛形では空のまま残す。
# model id を固定するのは意図的で、省くと「そのとき最も新しいモデル」に対して
# 評価するので、モデルを編集した瞬間にすべての判断が変わる。
CAPTURE_LEDGER_FGA_STORE_ID=
CAPTURE_LEDGER_FGA_MODEL_ID=
#CAPTURE_LEDGER_FGA_API_URL=http://localhost:8090
#CAPTURE_LEDGER_FGA_API_TOKEN=dev-key
# scripts/fga-deploy.mjs が作る store の名前。
#CAPTURE_LEDGER_FGA_STORE_NAME=wacz-validator
# scripts/fga-migrate.mjs が使う。migrate は distroless なので別手順になっている。
#CAPTURE_LEDGER_FGA_IMAGE=docker.io/openfga/openfga:v1.10.2
#CAPTURE_LEDGER_FGA_DATASTORE_URI=

# ── 主体 (本物の IdP が来るまでの足場) ──────────────────────────────
# 1 のとき X-Capture-ledger-Subject をそのまま信じる。**未設定でも API は起動する** が、
# resolver が denyAll になるので一覧が常に 401 になる。picker が空に見える原因は
# たいていこれ。
#
# 主体を環境変数から組み立てる経路 (CAPTURE_LEDGER_DEV_SUBJECT / CAPTURE_LEDGER_DEV_ORGANIZATIONS)
# は、それを読んでいた CLI ごと畳んだので無くなった。いまは投げる側がヘッダか JWT で
# 名乗る。
CAPTURE_LEDGER_DEV_IDENTITY=1

# ── 主体 (JWT の経路) ───────────────────────────────────────────────
# ここを設定すると、API は **本番と同じ検証コード** を通る ——
# 署名・iss・aud・期限・JWKS の取得。`pnpm run oidc:issuer` が開発用の issuer を
# 立てるので、本物の IdP が決まるまではその URL を書く。本物へ移るとき変わるのは
# この 2 行だけで、resolver は 1 行も変わらない。
#
# **開発用ヘッダ (CAPTURE_LEDGER_DEV_IDENTITY) より優先される。** 両方設定された環境で
# 弱いほうへ落ちてはいけないので、そう決めてある。
#CAPTURE_LEDGER_OIDC_ISSUER=http://127.0.0.1:9099
#CAPTURE_LEDGER_OIDC_AUDIENCE=capture-ledger
# 開発用 issuer の待受。
#CAPTURE_LEDGER_DEV_ISSUER_PORT=9099
#
# トークンそのものは pnpm run oidc:token が出す
# (`TOKEN=$(pnpm run oidc:token --subject alice --org acme)`)。**.env には置かない**
# —— 読むのは受け取る側の API で、投げる側がヘッダに載せるものだから。

# ── 成果物の受け口 ────────────────────────────────────────────────────
# BrowserHive に成果物を押し出させるための鍵。**設定しなければ口を出さない** ——
# 署名できない受け口は誰でも書ける受け口で、それは無いほうがましだから。
#
# 設定すると `PUT /api/sink/:crawlId/:filename` が生え、capture-ledger がクロールごとに
# 1 回きりのトークンを発行して BrowserHive へ渡す。BrowserHive が持つのはその口だけで、
# bucket も prefix も知らない —— 置き場所を決めるのはこちら
# (`org/<orgId>/<YYYY-MM>/<filename>`。接頭辞はクロールを作るときに決めて
# `crawls.artifact_key_prefix` に書き残す。`013` を見ること)。
#
# 未設定なら BrowserHive は従来どおり自前の保管庫へ書く。**両方の経路が同時に生きる。**
# **2 つで 1 組。** 片方だけだと受け口は生えず、起動時に warn が出る。
#
# origin は **BrowserHive から届く** capture-ledger の起点。BrowserHive はコンテナ、capture-api は
# host なので localhost ではなく、コンテナから見た host の IP —— default ネットワークの gateway ——
# を書く。調べるのは 1 行 (network を作り直すと変わるので、例の IP を写さない):
#   container network inspect default | jq -r '.[0].status.ipv4Gateway'
# **`capture-ledger` というコンテナは無い** (compose に無く、API は host で走る)。
# あわせて `CAPTURE_LEDGER_API_HOST=0.0.0.0` が要る。
#CAPTURE_LEDGER_SINK_ORIGIN=http://<gateway>:7070
#CAPTURE_LEDGER_SINK_SECRET=

# ── その他 ──────────────────────────────────────────────────────────
# ログの量。trace / debug / info / warn / error / fatal。
LOG_LEVEL=info
# picker と API のポート。open http://127.0.0.1:7070/ で picker が開く。
CAPTURE_LEDGER_API_PORT=7070
# API が待ち受けるアドレス。既定は 127.0.0.1 —— このプロセスは取り込みを起こせる
# 口(POST /api/crawls)を持つので、既定では外に出さない。
#
# **クロールを使うなら 0.0.0.0 が要る。** flow (capture-scheduler の Windmill) は段ごとの結果を
# この API に報告し、その報告はコンテナから来る —— 手で起こしたクロールでも同じ。loopback だけに
# bind したプロセスはコンテナから届かない (実測)。コンテナから見た host は default ネットワークの
# gateway で (ホスト名では引けない)、network を作り直すと変わる。capture-scheduler の
# `windmill:capture-ledger-token` がその場で読んで Windmill に渡すので、ここには書かない。
# 外に出す以上、前段で必ず認証を掛けること。
#CAPTURE_LEDGER_API_HOST=127.0.0.1

# API から起こした実行が取る形式 (カンマ区切り: png,webp,html,links,mhtml,wacz)。
# 呼び出し元は選べない —— 外のスケジューラが決めるのは「いつ」であって「何を」では
# ないため。既定は wacz。**起動時に検査する**ので、綴りを間違えると API は上がらない。
#CAPTURE_LEDGER_CAPTURE_FORMATS=wacz
# 1 なら、取り込みに wacz-auth 署名を要求する。wacz が要る。
#
# **これはスタックの起動も変える。** `pnpm run stack:up` がこの行を見て、
# wacz-signer と tsa を起こし (--profile signing)、署名の宛先を BrowserHive に渡す
# (--env-file signing.env)。片方だけを渡す道は無い —— 以前はここが 3 か所に
# 分かれていて、署名を on にすると取り込みが全部落ちた。
#CAPTURE_LEDGER_CAPTURE_SIGNING=1

# リンクを辿るクロールを Windmill の flow に投げるための webhook。
# **両方まとめて設定すること** —— 片方だけだと起動時に落とします。どちらも無ければ
# `/api/crawls` を出しません（その配備にこの能力は無い、が正しい答えなので 404）。
# **2 行とも capture-scheduler の `pnpm run windmill:bootstrap` が出す**ので、それを貼る (URL を
# 手で組み立てない)。bootstrap を済ませてあるなら、URL は下の例のとおり、token は capture-scheduler の
# `.env` の `WINDMILL_TOKEN` と同じ値。
# **`f/waggle/` は Windmill の flow のパスで、repo 名ではない。** capture-scheduler 側の
# windmill/f/waggle/ が実体で、変えると webhook の URL が変わる。改名では据え置いた。
#
# **URL の末尾は flow の名前 (crawl_level) で、決めているのは capture-scheduler。** あちらの
# windmill/f/waggle/crawl_level.flow が実体。名前が違っていても API は普通に起動し、
# `POST /api/crawls` も 202 を返す —— 分かるのはその後で、クロールが failed になり、API の
# ログに `crawl webhook → 404 Not found: flow not found at name …` が出る。この例は
# 2026-09 まで `…/f/waggle/crawl` と書いてあり、そのとおりに設定するとそうなった。
#CAPTURE_LEDGER_CRAWL_WEBHOOK_URL=http://127.0.0.1:8000/api/w/crawler/jobs/run/f/f/waggle/crawl_level
#CAPTURE_LEDGER_CRAWL_WEBHOOK_TOKEN=
# webhook を叩くときの待ち時間。既定は 10 秒。
#CAPTURE_LEDGER_CRAWL_WEBHOOK_TIMEOUT_MS=10000
#CAPTURE_LEDGER_DRAIN_INTERVAL_MS=
# picker が組み立てる replay の場所。replay は capture-ledger 専用ではないので env にある。
# **既定値は「replay を同じ機械の 8899 で動かしている」前提。** 別の場所で動かすなら
# 必ず変える —— 間違っていても picker は開き、行をクリックした先で初めて分かる。
REPLAY_ORIGIN=http://127.0.0.1:8899
#MIGRATION_FOLDER=
#SEED_FOLDER=

# 全文検索の索引 (OpenSearch)。**無ければ `/api/search` と索引の口を出しません** ——
# その配備に検索は無い、が正しい答えなので 404 になります。
# compose では既定で立ちません: container-compose --profile search up -d -b
#CAPTURE_LEDGER_OPENSEARCH_URL=http://127.0.0.1:9200
# 索引の名前。既定は capture-pages。解析器を変えたら別の名前にするか、
# `UPDATE archives SET indexed_at = NULL` で作り直すこと。
#CAPTURE_LEDGER_OPENSEARCH_INDEX=capture-pages
